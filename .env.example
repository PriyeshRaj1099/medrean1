# ============================================================
#  MediLens AI — environment configuration template
#  Copy this file to `.env` and fill in real values.
#  NEVER commit the real .env file.
# ============================================================

# ---- Application ----
APP_NAME=MediLens AI
ENVIRONMENT=development          # development | production | test
DEBUG=true
FRONTEND_URL=http://localhost:3000

# ---- Database ----
# Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://medilens:medilens@localhost:5432/medilens
# Local development fallback (SQLite, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./backend/var/medilens_dev.db
# Create tables on startup from the SQLAlchemy models (development convenience).
# In production run `alembic upgrade head` instead and set this to false.
AUTO_CREATE_SCHEMA=true

# ---- Authentication ----
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# "Remember me" = false: server session lives this long and the refresh cookie
# is a browser-session cookie (cleared when the browser closes).
SESSION_REFRESH_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# Dev helper: include the password-reset token in the API response so the
# flow can be tested without an email provider. NEVER enable in production.
AUTH_DEV_RETURN_RESET_TOKEN=false

# ---- Shared demo account ----
# A publicly documented account for exploring the product. It is created (or
# verified) by the idempotent seed:  python scripts/seed_demo_account.py
# It signs in through the normal authentication pipeline, has the non-admin
# role "demo", and can neither upload reports, change its password, delete
# itself nor manage sessions. These demo-only credentials are displayed
# openly on the sign-in screen — never reuse them for a real account.
DEMO_ACCOUNT_ENABLED=true
DEMO_ACCOUNT_EMAIL=demo@medilens.ai
DEMO_ACCOUNT_PASSWORD=MediLens@Demo2026!
DEMO_ACCOUNT_NAME=Demo Explorer

# ---- Optional Google sign-in ----
# Both values are required to enable "Continue with Google"; leave blank to
# hide the option. Authorized redirect URI: {API_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Secure share links ----
# Default lifetime of a report share link and the allowed maximum (days).
SHARE_LINK_EXPIRE_DAYS=7
SHARE_LINK_MAX_EXPIRE_DAYS=30

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000

# ---- File storage ----
STORAGE_BACKEND=local            # local | s3
STORAGE_LOCAL_DIR=./backend/var/uploads
# S3-compatible object storage (production):
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=us-east-1
MAX_UPLOAD_SIZE_MB=20

# ---- AI provider ----
# mock  = offline deterministic engine (no API key needed, clearly labelled)
# openai = any OpenAI-compatible API (OpenAI, Azure-compatible gateways,
#          OpenRouter, Groq, Ollama, vLLM, ...)
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=90
AI_MAX_OUTPUT_TOKENS=4000

# ---- Embeddings (RAG) ----
# mock  = deterministic local hashing embeddings (offline, no key needed)
# openai = OpenAI-compatible embeddings endpoint
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512

# ---- OCR ----
# tesseract | paddle | none
# Tesseract must be installed on the host (https://tesseract-ocr.github.io/).
OCR_PROVIDER=tesseract
OCR_LANGUAGES=eng
OCR_DPI=250
OCR_MIN_TEXT_CHARS=40

# ---- RAG ----
RAG_TOP_K=6
RAG_MIN_SCORE=0.12
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
VECTOR_DATABASE_URL=             # reserved for a dedicated vector DB (pgvector/Chroma)

# ---- Processing pipeline ----
LOW_CONFIDENCE_THRESHOLD=0.7
AUTO_ANALYZE_AFTER_EXTRACTION=true
DATA_RETENTION_DAYS=0            # 0 = keep until user deletes

# ---- Observability ----
LOGGING_LEVEL=INFO
LOG_JSON=false
RATE_LIMIT_ENABLED=true
